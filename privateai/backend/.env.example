# PrivateAI backend environment
# Copy to .env and adjust, or set these before running

# LLM backend: "ollama" (default, easiest) or "llamacpp"
LLM_BACKEND=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# llama.cpp settings (only if LLM_BACKEND=llamacpp)
LLAMACPP_PATH=./llama.cpp/main
LLAMACPP_MODEL_PATH=./models/gemma-2b-q4_k_m.gguf
LLAMACPP_CTX=2048
LLAMACPP_THREADS=4

# Timeout in seconds
LLM_TIMEOUT=30
